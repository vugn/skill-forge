{
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "name": "skill-forge",
  "version": "1.0.0",
  "description": "AI-powered skill development platform built on Internet Computer Protocol (ICP)",
  "keywords": [
    "ai",
    "learning",
    "skill-development",
    "icp",
    "education",
    "career"
  ],
  "scripts": {
    "setup": "npm install && dfx start --background && npm run deploy",
    "dev": "npm run start --workspaces --if-present",
    "start": "npm start --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "prebuild": "npm run prebuild --workspaces --if-present",
    "deploy": "dfx deploy",
    "deploy:local": "dfx deploy --network local",
    "deploy:ic": "dfx deploy --network ic",
    "generate": "dfx generate",
    "pretest": "npm run prebuild --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "clean": "dfx stop && rm -rf .dfx && npm run clean --workspaces --if-present"
  },
  "type": "module",
  "workspaces": [
    "src/skill-forge-frontend"
  ],
  "author": "SkillForge Team",
  "license": "MIT",
  "dependencies": {
    "react-draggable": "^4.5.0",
    "react-zoom-pan-pinch": "^3.7.0"
  }
}
