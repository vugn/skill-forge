# SkillForge Environment Variables

# Development settings
NODE_ENV=development
VITE_NODE_ENV=development

# DFX Network Settings
DFX_NETWORK=local

# Canister IDs (will be auto-generated after deployment)
VITE_SKILL_FORGE_BACKEND_CANISTER_ID=
VITE_SKILL_FORGE_FRONTEND_CANISTER_ID=

# Internet Computer Settings
VITE_IC_HOST=http://localhost:4943
VITE_IC_IDENTITY_PROVIDER=http://rdmx6-jaaaa-aaaah-qdrqq-cai.localhost:4943

# Application Settings
VITE_APP_NAME=SkillForge
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=AI-Powered Skill Development Platform

# Feature Flags
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_SOCIAL_FEATURES=false
VITE_ENABLE_CERTIFICATION=false
